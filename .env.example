# Copy to .env and set a local password. .env is ignored by Git.
HMRP_PG_HOST=127.0.0.1
HMRP_PG_PORT=55432
HMRP_PG_DB=hmrp
HMRP_PG_USER=hmrp
HMRP_PG_PASSWORD=change-me-local-only
# Database used by pytest integration tests (created automatically, dropped/recreated per test session)
HMRP_PG_TEST_DB=hmrp_test
# Optional PostgreSQL resource settings used by compose.yaml
HMRP_PG_SHARED_BUFFERS=2GB
HMRP_PG_WORK_MEM=256MB
HMRP_PG_MAINTENANCE_WORK_MEM=1GB
HMRP_PG_MAX_WAL_SIZE=8GB
HMRP_PG_PARALLEL_WORKERS=4
# Optional: directory with transactions_train.csv, customers.csv, articles.csv
# HNM_DATA_DIR=D:/data/hm
